generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  thumbnail   String?
  status      String    @default("PUBLISHED")
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                  String        @id @default(uuid())
  name                String
  slug                String        @unique
  sku                 String        @unique
  modelNumber         String?
  brand               String?       @default("ORIVENCE")
  description         String
  material            String?       @default("Surgical-grade Stainless Steel")
  finish              String?       @default("Satin Electro-polished")
  dimensions          String?
  length              String?
  width               String?
  tipSize             String?
  jawSize             String?
  weight              String?
  applications        String?
  features            String?
  packaging           String?
  downloads           String?
  imagesJson          String
  videoUrl            String?
  relatedProductsJson String?
  seoTitle            String?
  seoDescription      String?
  seoKeywords         String?
  featured            Boolean       @default(false)
  status              String        @default("PUBLISHED")
  orderIndex          Int           @default(0)
  specJson            String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  categoryId          String
  inquiryItems        InquiryItem[]
  category            Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Inquiry {
  id              String           @id @default(uuid())
  referenceNo     String           @unique
  name            String
  companyName     String?
  website         String?
  country         String
  email           String
  phone           String?
  whatsapp        String?
  message         String?
  attachments     String?
  status          String           @default("NEW")
  internalNotes   String?
  assignedAgent   String?
  followUpDate    DateTime?
  activityHistory String?
  productName     String?
  sku             String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  comments        InquiryComment[]
  items           InquiryItem[]
}

model InquiryItem {
  id        String   @id @default(uuid())
  inquiryId String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InquiryComment {
  id        String   @id @default(uuid())
  inquiryId String
  author    String
  text      String
  createdAt DateTime @default(now())
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id        String   @id @default(uuid())
  filename  String
  url       String
  type      String
  size      Int
  folder    String   @default("/")
  altText   String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id               String    @id @default(uuid())
  username         String    @unique
  passwordHash     String
  role             String    @default("CONTENT_MANAGER")
  email            String?
  status           String    @default("ACTIVE")
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  username  String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model BackupRecord {
  id        String   @id @default(uuid())
  filename  String
  size      Int
  type      String   @default("AUTOMATIC")
  url       String
  createdAt DateTime @default(now())
}

model WebsiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String
  path      String?
  productId String?
  metaJson  String?
  ipAddress String?
  country   String?
  createdAt DateTime @default(now())
}
