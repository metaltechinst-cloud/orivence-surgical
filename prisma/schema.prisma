// prisma/schema.prisma

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  thumbnail   String?
  status      String    @default("PUBLISHED") // "PUBLISHED", "DRAFT"
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id                  String    @id @default(uuid())
  name                String
  slug                String    @unique
  sku                 String    @unique
  modelNumber         String?
  brand               String    @default("ORIVENCE")
  description         String
  material            String?   @default("Surgical-grade Stainless Steel")
  finish              String?   @default("Satin Electro-polished")
  dimensions          String?
  length              String?
  width               String?
  tipSize             String?
  jawSize             String?
  weight              String?
  applications        String?   // JSON string array
  features            String?   // JSON string array
  packaging           String?
  downloads           String?   // JSON string array of download links
  imagesJson          String    // JSON string array of image URLs
  videoUrl            String?
  relatedProductsJson String?   // JSON string array of product IDs
  seoTitle            String?
  seoDescription      String?
  seoKeywords         String?
  featured            Boolean   @default(false)
  status              String    @default("PUBLISHED") // "PUBLISHED", "DRAFT"
  orderIndex          Int       @default(0)
  specJson            String?   // Flexible Key-Value JSON specs
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  categoryId          String
  category            Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  inquiryItems        InquiryItem[]
}

model Inquiry {
  id              String         @id @default(uuid())
  referenceNo     String         @unique
  name            String
  companyName     String?
  website         String?
  country         String
  email           String
  phone           String?
  whatsapp        String?
  message         String?
  attachments     String?        // JSON string array of file URLs
  status          String         @default("NEW") // "NEW", "IN_REVIEW", "QUOTED", "CLOSED"
  internalNotes   String?
  assignedAgent   String?
  followUpDate    DateTime?
  activityHistory String?        // JSON log of changes
  productName     String?        // Main/First product for display
  sku             String?        // Main product SKU
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items           InquiryItem[]
  comments        InquiryComment[]
}

model InquiryItem {
  id          String   @id @default(uuid())
  inquiryId   String
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())
}

model InquiryComment {
  id          String   @id @default(uuid())
  inquiryId   String
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author      String
  text        String
  createdAt   DateTime @default(now())
}

model MediaAsset {
  id        String   @id @default(uuid())
  filename  String
  url       String
  type      String
  size      Int
  folder    String   @default("/")
  altText   String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  passwordHash       String
  role               String    @default("CONTENT_MANAGER") // OWNER, ADMIN, CONTENT_MANAGER, VIEWER
  email              String?
  status             String    @default("ACTIVE") // ACTIVE, SUSPENDED
  twoFactorEnabled   Boolean   @default(false)
  twoFactorSecret    String?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  username  String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model BackupRecord {
  id        String   @id @default(uuid())
  filename  String
  size      Int
  type      String   @default("AUTOMATIC") // AUTOMATIC, MANUAL
  url       String
  createdAt DateTime @default(now())
}

model WebsiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   // Serialized JSON or plain text
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String   // PAGE_VIEW, RFQ_SUBMIT, DOWNLOAD, CLICK
  path      String?
  productId String?
  metaJson  String?
  ipAddress String?
  country   String?
  createdAt DateTime @default(now())
}
